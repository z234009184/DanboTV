<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="@dimen/vs_480"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/shape_dialog_bg_main"
        android:orientation="vertical"
        android:padding="@dimen/vs_30">

        <!-- 标题：发现新版本 -->
        <TextView
            android:id="@+id/updateTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/color_FFFFFF"
            android:textSize="@dimen/ts_26"
            android:textStyle="bold"
            tools:text="发现新版本 V1.1.0" />

        <!-- 文件大小 -->
        <TextView
            android:id="@+id/updateFileSize"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_10"
            android:gravity="center"
            android:textColor="@color/color_FFFFFF_80"
            android:textSize="@dimen/ts_18"
            android:visibility="gone"
            tools:text="大小: 34.5MB"
            tools:visibility="visible" />

        <!-- 更新日志（可滚动） -->
        <ScrollView
            android:id="@+id/updateLogScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/vs_15"
            android:layout_weight="1"
            android:maxHeight="@dimen/vs_300"
            android:scrollbars="vertical">

            <TextView
                android:id="@+id/updateLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="@dimen/vs_5"
                android:textColor="@color/color_FFFFFF_80"
                android:textSize="@dimen/ts_20"
                tools:text="1. 修复视频播放卡顿问题\n2. 新增首页推荐功能" />
        </ScrollView>

        <!-- 下载进度条 -->
        <LinearLayout
            android:id="@+id/updateProgressLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_15"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:visibility="visible">

            <ProgressBar
                android:id="@+id/updateProgressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="@dimen/vs_8"
                android:layout_weight="1"
                android:max="100"
                android:progressDrawable="@drawable/play_progress_horizontal" />

            <TextView
                android:id="@+id/updateProgressText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/vs_10"
                android:textColor="@color/color_FFFFFF"
                android:textSize="@dimen/ts_18"
                tools:text="45%" />
        </LinearLayout>

        <!-- 按钮区域 -->
        <LinearLayout
            android:id="@+id/updateBtnLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/vs_20"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/updateBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="@dimen/vs_5"
                android:background="@drawable/button_dialog_main"
                android:focusable="true"
                android:gravity="center"
                android:padding="@dimen/vs_10"
                android:text="立即更新"
                android:textColor="@color/color_FFFFFF"
                android:textSize="@dimen/ts_22" />

            <TextView
                android:id="@+id/updateSkipBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/vs_5"
                android:background="@drawable/button_dialog_main"
                android:focusable="true"
                android:gravity="center"
                android:padding="@dimen/vs_10"
                android:text="跳过此版本"
                android:textColor="@color/color_FFFFFF"
                android:textSize="@dimen/ts_22" />
        </LinearLayout>

    </LinearLayout>
</FrameLayout>
