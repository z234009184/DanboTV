<?xml version="1.0" encoding="utf-8"?>
<!-- APP软件管理图标和略缩图单独圆角背景 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <corners android:radius="@dimen/vs_12" />
            <solid android:color="@color/color_theme_30" />
            <stroke
                android:width="@dimen/vs_3"
                android:color="?attr/color_theme" />
        </shape>
    </item>
    <item android:state_focused="false">
        <shape>
            <corners android:radius="@dimen/vs_12" />
            <solid android:color="@color/bg_card_soft" />
            <stroke
                android:width="@dimen/vs_1"
                android:color="@color/line_soft" />
        </shape>
    </item>
</selector>
