<?xml version="1.0" encoding="utf-8"?>
<!-- 搜索框进入 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!--获得焦点-->
    <item android:state_focused="true">
        <shape>
            <corners android:radius="@dimen/vs_14" />
            <solid android:color="@color/bg_panel_soft" />
            <stroke
                android:width="@dimen/vs_2"
                android:color="?attr/color_theme" />
        </shape>
    </item>
    <!--默认-->
    <item android:state_focused="false">
        <shape>
            <corners android:radius="@dimen/vs_14" />
            <solid android:color="@color/bg_card_soft" />
            <stroke
                android:width="@dimen/vs_1"
                android:color="@color/line_soft" />
        </shape>
    </item>
</selector>
