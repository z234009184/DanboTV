<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?attr/color_theme_dark_70">
    <item>
        <selector xmlns:android="http://schemas.android.com/apk/res/android">
            <item
                android:state_focused="true"
                android:state_pressed="true">
                <shape>
                    <corners android:radius="@dimen/vs_14" />
                    <solid android:color="?attr/color_theme_dark_70" />
                </shape>
            </item>
            <item
                android:state_focused="false"
                android:state_pressed="true">
                <shape>
                    <corners android:radius="@dimen/vs_14" />
                    <solid android:color="?attr/color_theme_dark_70" />
                </shape>
            </item>
            <item android:state_focused="true">
                <shape>
                    <corners android:radius="@dimen/vs_14" />
                    <solid android:color="?attr/color_theme_dark_70" />
                    <stroke
                        android:width="@dimen/vs_2"
                        android:color="@color/color_FFFFFF_90" />
                </shape>
            </item>
            <item
                android:state_focused="false"
                android:state_pressed="false">
                <shape>
                    <corners android:radius="@dimen/vs_14" />
                    <solid android:color="@color/bg_card_soft" />
                    <stroke
                        android:width="@dimen/vs_1"
                        android:color="@color/line_soft" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
